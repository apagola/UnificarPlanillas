                    s.AppendLine("	FROM piezas_Crystal ")
                    s.AppendLine("	WHERE (idPiezasNumerosSerie = '" & idPieza & "') ")
                    s.AppendLine(") AS a ")
                    s.AppendLine("LEFT OUTER JOIN ")
                    s.AppendLine("( ")
                    s.AppendLine("	SELECT DISTINCT ")
                    s.AppendLine("		CAST(2 AS int) AS taulabi, dae.idPlano, dae.idOperacionAtornillado, dae.FechaIni, dae.FechaFin, ")
                    s.AppendLine("		dae.PlaColNumSerie, dae.Plano, dae.Colada, dae.Nserie, dae.Descripcion, dae.OpeLado, ")
                    s.AppendLine("		dae.nTornillo, dae.MinimoPar, dae.MaximoPar, dae.Par, dae.MinimoAng, dae.MaximoAng, dae.Angulo, ")
                    s.AppendLine("		dae.estadoOperacion, dae.resultado, pieza.idPieza ")
                    s.AppendLine("	FROM datosAtornilladoEgoki AS dae ")
                    s.AppendLine("	INNER JOIN ")
                    s.AppendLine("	( ")
                    s.AppendLine("		SELECT hp.idPieza, hp.Nserie, hp.colada ")
                    s.AppendLine("		FROM dbo.historicoProduc AS hp INNER JOIN dbo.planosRutasOperaciones AS pro ON hp.idOperacion = pro.id ")
                    s.AppendLine("		WHERE (hp.idPieza = '" & idPieza & "') AND (pro.parte = 0) AND (pro.solicitar_N_Serie = 'True') ")
                    s.AppendLine("			AND (pro.solicitar_Colada = 'True') AND (hp.cancelada = 'False') AND (hp.respuesta = 'true') ")
                    s.AppendLine("  	  AND (hp.colada <> '') ")
                    s.AppendLine("  	  AND (hp.Nserie <> '')")
                    s.AppendLine("	) AS pieza ON dae.Colada = pieza.colada AND dae.Nserie = pieza.Nserie ")
                    ' ID 340 - Solo salen a la planilla las operaciones DE APRIETE (igual que historicoProduc.crystal del web).
                    ' datosAtornilladoEgoki guarda todas las operaciones de la ruta de montaje, no solo los aprietes:
                    ' aplicar Molycote, aplicar Tectyl, limpiar, marcar, barnizar, "operaciones finales"... Esas no aprietan
                    ' nada y salian en el Crystal como filas en blanco (CAF, eje colada 101507 / nSerie 0078).
                    ' Que cuenta como apriete: la operacion que tiene LIMITES definidos, es decir MaximoPar <> 0
                    ' o MaximoAng <> 0 (hay aprietes controlados solo por par y otros solo por angulo, de ahi el OR).
                    ' Se mira el LIMITE y no el valor medido (dae.Par / dae.Angulo) a proposito: un apriete real
                    ' registrado con par 0 -una llave que no midio- tiene que seguir apareciendo en un informe que
                    ' certifica pares de apriete. Filtrar por el valor medido lo haria desaparecer sin dejar rastro.
                    ' El filtro va DENTRO de la subconsulta del LEFT OUTER JOIN, nunca en el WHERE exterior ni
                    ' convirtiendo el join en INNER: los datos de la pieza viajan en estas mismas filas, asi que
                    ' filtrar fuera dejaria sin informe a los ejes que no tengan atornillado.
                    s.AppendLine("	WHERE (dae.estadoOperacion = 'True') AND (dae.resultado = 'True') ")
                    s.AppendLine("		AND (ISNULL(dae.MaximoPar, 0) <> 0 OR ISNULL(dae.MaximoAng, 0) <> 0) ")
                    s.AppendLine(") AS b ON a.idPiezasNumerosSerie = b.idPieza ")
                    s.AppendLine("LEFT OUTER JOIN ")
                    s.AppendLine("( ")
                    s.AppendLine("  SELECT kunstler.nSerie AS KUNSTLER_NUM, kunstler.proximaCalibracion AS KUNSTLER_FECHA, kolga.nSerie AS KOLGA_NUM, kolga.proximaCalibracion AS KOLGA_FECHA")
                    s.AppendLine("  	  , rodamientos1.nSerie AS RODAMIENTOS1_NUM, rodamientos1.proximaCalibracion AS RODAMIENTOS1_FECHA, rodamientos2.nSerie AS RODAMIENTOS2_NUM")
                    s.AppendLine("  	  , rodamientos2.proximaCalibracion AS RODAMIENTOS2_FECHA, dinamoE1.nSerie AS DINAMO_E1_NUM, dinamoE1.proximaCalibracion AS DINAMO_E1_FECHA, dinamoE2.nSerie AS DINAMO_E2_NUM")
                    s.AppendLine("  	  , dinamoE2.proximaCalibracion AS DINAMO_E2_FECHA, dinamo.nSerie AS DINAMO_NUM, dinamo.proximaCalibracion AS DINAMO_FECHA, pieza_1.idPieza")
                    s.AppendLine("  	  , micro.nSerie AS MICROMETRO_NUM, micro.proximaCalibracion AS MICROMETRO_FECHA")
                    s.AppendLine("  	  , comparador.nSerie AS COMPARADOR_NUM, comparador.proximaCalibracion AS COMPARADOR_FECHA")
                    s.AppendLine("  	  , calibre.nSerie AS CALIBRE_NUM, calibre.proximaCalibracion AS CALIBRE_FECHA")
                    s.AppendLine("  	  , dinamolc.nSerie AS DINAMOLC_NUM, dinamolc.proximaCalibracion AS DINAMOLC_FECHA")
                    s.AppendLine("  	  , dinamoscs.nSerie AS DINAMOSCS_NUM, dinamoscs.proximaCalibracion AS DINAMOSCS_FECHA")
                    s.AppendLine("  FROM (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion WHERE (id = 1)) AS kunstler ")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_6 WHERE (id = 2)) AS kolga ")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_5 WHERE (id = 3)) AS rodamientos1 ")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_4 WHERE (id = 4)) AS rodamientos2 ")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_3 WHERE (id = 5)) AS dinamoE1")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_2 WHERE (id = 6)) AS dinamoE2 ")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_1 WHERE (id = 7)) AS dinamo")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_8 WHERE (id = 8)) AS micro")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_9 WHERE (id = 9)) AS comparador")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_10 WHERE (id = 10)) AS calibre")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_11 WHERE (id = 11)) AS dinamolc")
                    s.AppendLine("  CROSS JOIN (SELECT nSerie, proximaCalibracion FROM dbo.maquinas_proximaCalibracion AS maquinas_proximaCalibracion_12 WHERE (id = 12)) AS dinamoscs")
                    s.AppendLine("  INNER JOIN (")
                    ' DISTINCT y solo idPieza: sin el, sale una fila por cada operacion que pide colada + nSerie
                    ' (p.ej. 2 de atornillado), "c" se multiplica y duplica todo el atornillado (eje colada 101747 / nSerie 0019).
                    s.AppendLine("  	SELECT DISTINCT hp.idPieza AS idPieza FROM dbo.historicoProduc AS hp ")
                    s.AppendLine("  	INNER JOIN dbo.planosRutasOperaciones AS pro ON hp.idOperacion = pro.id")
                    s.AppendLine("  	WHERE (hp.idPieza = '" & idPieza & "') ")
                    s.AppendLine("  	  AND (pro.parte = 0) ")
                    s.AppendLine("  	  AND (pro.solicitar_N_Serie = 'True') ")
                    s.AppendLine("  	  AND (pro.solicitar_Colada = 'True') ")
                    s.AppendLine("  	  AND (hp.colada <> '') ")
                    s.AppendLine("  	  AND (hp.Nserie <> '')")
                    s.AppendLine("  ) AS pieza_1 ON 1 = 1")
                    s.AppendLine(") AS c ON a.idPiezasNumerosSerie = c.idPieza ")
                    's.AppendLine("SELECT a.taulabat, a.idPiezasNumerosSerie, a.PEDIDO, a.NOMBRE, a.ITM, a.ED, a.PLANO, a.ED_PLANO, a.PLANO_MODELO, a.ED_PLANO_MODELO, a.MODELO, a.EJE_CALADO, a.CAJA1, a.CAJA2, ")
