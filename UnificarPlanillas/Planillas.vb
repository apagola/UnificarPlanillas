        s.AppendLine("					/* TEXTO */")
        s.AppendLine("					SELECT ECalado, EJE_NS, indicatorname COLLATE Modern_Spanish_CI_AS as indicatorname, indicatorvalue ")
        s.AppendLine("					FROM ")
        s.AppendLine("					(")
        s.AppendLine("						SELECT DISTINCT TOP 1 dr.id, dr.Fecha, dr.EJE_NS, CAST(dr.ECalado AS NVARCHAR) AS ECalado, ")
