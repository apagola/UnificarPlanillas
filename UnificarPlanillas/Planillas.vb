        s.AppendLine("				) as dk_3 on a.varmaquina = dk_3.indicatorname")
        s.AppendLine("			) as a")
        s.AppendLine("			WHERE (a.orden = @iIlara)")
        s.AppendLine("			)")
        s.AppendLine("			IF @Col <> ''")
