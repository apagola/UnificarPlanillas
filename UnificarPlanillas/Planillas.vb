        s.AppendLine("						--OrderNumber, OrderStart, OrderEnd, WheelSetNumber, WheelSetType, ARact, luzera, resistance, AR1, AR2, AR3, AR4, AbortOrder")
        s.AppendLine("						SELECT dko.id, 0 as part, dko.WheelSetNumber, dko.OrderNumber, dko.ARact / 1000.0 AS ARact, dko.luzera / 1000.0 AS luzera, dko.AR1 / 1000.0 AS AR1, dko.AR2 / 1000.0 AS AR2, dko.AR3 / 1000.0 AS AR3, dko.AR4 / 1000.0 AS AR4")
        s.AppendLine("						FROM datosKunstlerOrder as dko ")
        s.AppendLine("						INNER JOIN ")
        s.AppendLine("						(")
        s.AppendLine("							SELECT hp.idPieza, hp.Nserie, hp.colada ")
        s.AppendLine("							FROM historicoProduc as hp INNER JOIN planosRutasOperaciones as pro on hp.idOperacion = pro.id ")
        s.AppendLine("							WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (pro.solicitar_N_Serie = 'True') AND (pro.solicitar_Colada = 'True') ")
        s.AppendLine("						) as pieza on (dko.WheelSetNumber LIKE (pieza.colada + '-' + pieza.Nserie))	")
        s.AppendLine("					) as a")
        s.AppendLine("				) as a ")
        s.AppendLine("				UNPIVOT ")
        s.AppendLine("				( ")
        s.AppendLine("					indicatorvalue ")
        s.AppendLine("					FOR indicatorname in (ARact, luzera, AR1, AR2, AR3, AR4) ")
        s.AppendLine("				) as unpiv ")
        s.AppendLine("			) as dkp_2 on varmaquina = dkp_2.indicatorname")
        s.AppendLine("			LEFT OUTER JOIN")
        s.AppendLine("			(")
        s.AppendLine("				SELECT id, part, WheelSetNumber, indicatorname COLLATE Modern_Spanish_CI_AS as indicatorname, ")
        s.AppendLine("				CAST(indicatorvalue as nvarchar) as indicatorvalue")
        s.AppendLine("				FROM ")
        s.AppendLine("				(")
        s.AppendLine("					SELECT DISTINCT a.*")
        s.AppendLine("					FROM ")
        s.AppendLine("					(")
        s.AppendLine("						--OrderNumber, OrderStart, OrderEnd, WheelSetNumber, WheelSetType, ARact, luzera, resistance, AR1, AR2, AR3, AR4, AbortOrder")
        s.AppendLine("						SELECT dko.id, 0 as part, dko.WheelSetNumber, dko.OrderNumber, CAST(dko.resistance as nvarchar) as resistance ")
        s.AppendLine("						FROM datosKunstlerOrder as dko ")
        s.AppendLine("						INNER JOIN ")
        s.AppendLine("						(")
        s.AppendLine("							SELECT hp.idPieza, hp.Nserie, hp.colada ")
        s.AppendLine("							FROM historicoProduc as hp INNER JOIN planosRutasOperaciones as pro on hp.idOperacion = pro.id ")
        s.AppendLine("							WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (pro.solicitar_N_Serie = 'True') AND (pro.solicitar_Colada = 'True') ")
        s.AppendLine("						) as pieza on (dko.WheelSetNumber LIKE (pieza.colada + '-' + pieza.Nserie))	")
        s.AppendLine("					) as a")
        s.AppendLine("				) as a ")
        s.AppendLine("				UNPIVOT ")
        s.AppendLine("				( ")
        s.AppendLine("					indicatorvalue ")
        s.AppendLine("					FOR indicatorname in (resistance) ")
        s.AppendLine("				) as unpiv ")
        s.AppendLine("			) as dkp_3 on varmaquina = dkp_3.indicatorname")
        s.AppendLine("		) as a ")
        s.AppendLine("		WHERE (a.orden = @iIlara)")
        s.AppendLine("		)")
        s.AppendLine("		SET @SQLLAG = 'UPDATE piezas_Crystal SET ' + @Col + ' = ''' + @Val + ' '' ' + ' WHERE (idPiezasNumerosSerie = ' + CAST(@idPieza as nvarchar) + ') AND (' + @Col + ' IS NULL)'")
        s.AppendLine("		EXEC(@SQLLAG) ")
        s.AppendLine("		SET @iIlara += 1")
        s.AppendLine("	END")
        Return funciones.cargar_todos(s.ToString())
    End Function


