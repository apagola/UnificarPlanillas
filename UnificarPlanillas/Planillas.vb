        s.AppendLine("			) as a")
        s.AppendLine("			WHERE (a.orden = @iIlara)")
        s.AppendLine("			)")
        s.AppendLine("			SET @Val = (SELECT a.indicatorvalue as val ")
        s.AppendLine("			FROM ")
        s.AppendLine("			(")
        s.AppendLine("				SELECT DISTINCT a.id, a.idRuta, a.idOperacion, a.idTipoOperacion, a.parte, a.idPuesto, a.idprov, a.orden, a.varmaquina, ")
