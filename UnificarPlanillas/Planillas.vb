        s.AppendLine("				(")
        s.AppendLine("					SELECT a.id, a.idRuta, a.idOperacion, a.idTipoOperacion, a.parte, a.idPuesto, a.idprov, a.orden, a.varmaquina, a.nColumna, b.idpieza, b.colada, b.Nserie")
        s.AppendLine("					FROM")
        s.AppendLine("					(")
        s.AppendLine("						SELECT pro.id, pro.idRuta, pro.idOperacion, pro.idTipoOperacion, pro.parte, pro.idPuesto, prov.id as idprov, prov.orden, prov.varmaquina, prov.nColumna ")
        s.AppendLine("						FROM planosRutasOperaciones as pro ")
        s.AppendLine("						LEFT OUTER JOIN planosRutaOperacionesValor as prov on pro.id = prov.idRutaOperacion ")
        s.AppendLine("						WHERE (pro.idTipoOperacion = 6) AND (idPuesto = 99) AND (pro.parte = @Parte)")
        s.AppendLine("					) as a")
        s.AppendLine("					INNER JOIN ")
        s.AppendLine("					(")
        s.AppendLine("						SELECT TOP 1 hp.colada, hp.Nserie, hp.idPieza, hp.idPlano, hp.idOperacion, pro.idRuta   ")
        s.AppendLine("						FROM historicoProduc as hp ")
        s.AppendLine("						INNER JOIN planosRutasOperaciones as pro on hp.idoperacion = pro.id")
        s.AppendLine("						WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (solicitar_N_Serie = 'True') AND (solicitar_Colada = 'True') AND cancelada = 'false'")
        s.AppendLine("						ORDER BY hp.id ASC ")
        s.AppendLine("					) as b on a.idRuta = b.idRuta ")
        s.AppendLine("				) as a ")
        s.AppendLine("				LEFT OUTER JOIN")
        s.AppendLine("				(")
        s.AppendLine("					/* FECHA */")
        s.AppendLine("					SELECT ECalado, EJE_NS, indicatorname COLLATE Modern_Spanish_CI_AS as indicatorname, ")
        s.AppendLine("						   CAST(CONVERT(nvarchar, indicatorvalue, 103) + ' ' + CONVERT(nvarchar, indicatorvalue, 108) as nvarchar) as indicatorvalue ")
        s.AppendLine("					FROM ")
        s.AppendLine("					(")
        s.AppendLine("						SELECT DISTINCT TOP 1 dr.id, dr.Fecha, dr.EJE_NS, CAST(dr.ECalado AS NVARCHAR) AS ECalado, ")
        s.AppendLine("										CAST(dr.Valor_A AS NVARCHAR) AS Valor_A, CAST(dr.Valor_B AS NVARCHAR) AS Valor_B, CAST(dr.Valor_C AS NVARCHAR) AS Valor_C,")
        s.AppendLine("										CAST(dr.Valor_D AS NVARCHAR) AS Valor_D, CAST(dr.holgura AS NVARCHAR) AS Holgura, CAST(dr.resistance as nvarchar) AS resistance")
        s.AppendLine("						FROM datosPrensa AS dr ")
        s.AppendLine("						INNER JOIN ")
        s.AppendLine("						(")
        s.AppendLine("							SELECT hp.idPieza, hp.Nserie, hp.colada")
        s.AppendLine("							FROM historicoProduc AS hp ")
        s.AppendLine("							INNER JOIN planosRutasOperaciones AS pro ON hp.idOperacion = pro.id ")
