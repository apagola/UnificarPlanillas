Imports System.Text

Public Class Planillas

#Region "PLANILLAS"
    Public Shared Function getPlanillasSinUnir() As DataTable
        Dim sql As StringBuilder = New StringBuilder
        sql.AppendLine("SELECT hp.idPieza, hp.colada, hp.Nserie ")
        sql.AppendLine("FROM historicoProduc AS hp ")
        sql.AppendLine("INNER JOIN planosRutasOperaciones AS pro ON pro.id = hp.idOperacion ")
        sql.AppendLine("INNER JOIN piezasNumerosSerie AS pins ON pins.id = hp.idPieza ")
        sql.AppendLine("WHERE pro.parte = 0 ")
        sql.AppendLine("AND hp.cancelada = 'False' ")
        sql.AppendLine("AND hp.colada <> '' ")
        sql.AppendLine("AND hp.Nserie <> '' ")
        sql.AppendLine("AND pins.generarReporte = 'True' ")
        sql.AppendLine("GROUP BY hp.idPieza, hp.colada, hp.Nserie ")
        Return funciones.cargar_todos(sql.ToString)
    End Function

    Public Shared Function updatePlanillaUnida(ByVal idPieza As String) As Integer
        Dim sql As StringBuilder = New StringBuilder
        sql.AppendLine("UPDATE piezasNumerosSerie ")
        sql.AppendLine("SET generarReporte = 'False', fechaReporte = '" & funciones.dateToDBString2(DateTime.Now) & "' ")
        sql.AppendLine("WHERE id = '" & idPieza & "' AND generarReporte = 'True' ")
        Return funciones.Update(sql.ToString)
    End Function
#End Region

#Region "AUXILIARES PLANILLAS - historicoProduc y plano"


    Public Shared Function get_infoPieza(id As Integer) As DataTable
        Dim s As StringBuilder = New StringBuilder()
        s.AppendLine("SELECT p.nombre, pns.nRueda, pns.nSerie, pns.nSerieCliente, MIN(inicio) AS inicio, pns.idEstado, ISNULL(plp.idEstado,1) AS estadoPLP, MAX(fin) AS fin, ")
        s.AppendLine("CONVERT(varchar, DATEADD(s,DATEDIFF(s, MIN(inicio), MAX(fin)),0), 108) as duracion, ")
        s.AppendLine("p.plano AS plano, p.id AS idPlano ")
        s.AppendLine("FROM piezasNumerosSerie as pns ")
        s.AppendLine("LEFT OUTER JOIN planos AS p ON p.id = pns.idplano ")
        s.AppendLine("LEFT OUTER JOIN historicoProduc AS hp ON hp.idpieza = pns.id ")
        s.AppendLine("LEFT OUTER JOIN pedidoLineasPiezas AS plp ON plp.id = pns.idPedidoNserie")
        s.AppendLine("WHERE (hp.fin > '2000') AND (pns.id = " & id & ") AND (hp.visibleEnHistorico = 'True') ")
        s.AppendLine("GROUP BY p.nombre, pns.nRueda, pns.nSerie, pns.nSerieCliente, pns.idEstado ,plp.idEstado, p.plano, p.id")
        Return funciones.cargar_todos(s.ToString)
    End Function

    Public Shared Function get_planoRtpInterna_idPieza(ByVal idPieza As Integer) As DataTable
        Dim s As New StringBuilder
        s.AppendLine("SELECT ISNULL(p.planillaInternaFicheroRPT,'') AS planillaInternaFicheroRPT")
        s.AppendLine("FROM piezasNumerosSerie AS pins ")
        s.AppendLine("LEFT OUTER JOIN planos AS p ON p.id = pins.idPlano ")
        s.AppendLine("WHERE pins.id = " & idPieza)
        Return funciones.cargar_todos(s.ToString)
    End Function

    Public Shared Function BaloreMaquinaPrensaEguneratu(ByVal idPieza As Integer) As Data.DataTable
        Dim s As New StringBuilder
        s.AppendLine("/* VALORES MAQUINA PRENSA */")
        s.AppendLine("DECLARE @SQLLAG as nvarchar(4000)")
        s.AppendLine("DECLARE @Col as nvarchar(30)")
        s.AppendLine("DECLARE @Val as nvarchar(30)")
        s.AppendLine("DECLARE @Zenbat as int")
        s.AppendLine("DECLARE @Parte as int")
        s.AppendLine("DECLARE @idPieza as int")
        s.AppendLine("")
        s.AppendLine("	SET @idPieza = " & idPieza)
        s.AppendLine("	SET @Parte = 1")
        s.AppendLine("	WHILE (@Parte <= 8)")
        s.AppendLine("	BEGIN")
        s.AppendLine("		SET @Zenbat = (SELECT MAX(a.orden) as zenbat")
        s.AppendLine("			FROM")
        s.AppendLine("			(")
        s.AppendLine("				SELECT DISTINCT a.id, a.idRuta, a.idOperacion, a.idTipoOperacion, a.parte, a.idPuesto, a.idprov, a.orden, a.varmaquina,")
        s.AppendLine("				a.nColumna, a.colada, a.Nserie, a.idpieza,")
        s.AppendLine("				ISNULL(dp_1.indicatorname, ISNULL(dp_2.indicatorname, dp_3.indicatorname)) as indicatorname,")
        s.AppendLine("				ISNULL(dp_1.indicatorvalue, ISNULL(dp_2.indicatorvalue, dp_3.indicatorvalue)) as indicatorvalue")
        s.AppendLine("				FROM")
        s.AppendLine("				(")
        s.AppendLine("					SELECT a.id, a.idRuta, a.idOperacion, a.idTipoOperacion, a.parte, a.idPuesto, a.idprov, a.orden, a.varmaquina, a.nColumna, b.idpieza, b.colada, b.Nserie")
        s.AppendLine("					FROM")
        s.AppendLine("					(")
        s.AppendLine("						SELECT pro.id, pro.idRuta, pro.idOperacion, pro.idTipoOperacion, pro.parte, pro.idPuesto, prov.id as idprov, prov.orden, prov.varmaquina, prov.nColumna")
        s.AppendLine("						FROM planosRutasOperaciones as pro LEFT OUTER JOIN planosRutaOperacionesValor as prov on pro.id = prov.idRutaOperacion")
        s.AppendLine("						WHERE (pro.idTipoOperacion = 6) AND (idPuesto = 99) AND (pro.parte = @Parte)")
        s.AppendLine("					) as a")
        s.AppendLine("					INNER JOIN")
        s.AppendLine("					(")
        s.AppendLine("						SELECT TOP 1 hp.colada, hp.Nserie, hp.idPieza, hp.idPlano, hp.idOperacion, pro.idRuta")
        s.AppendLine("						FROM historicoProduc as hp INNER JOIN planosRutasOperaciones as pro on hp.idoperacion = pro.id")
        s.AppendLine("						WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (solicitar_N_Serie = 'True') AND (solicitar_Colada = 'True') AND cancelada = 'false'")
        s.AppendLine("						ORDER BY hp.id ASC")
        s.AppendLine("					) as b on a.idRuta = b.idRuta")
        s.AppendLine("				) as a")
        s.AppendLine("				LEFT OUTER JOIN")
        s.AppendLine("				(")
        s.AppendLine("					/* FECHA */")
        s.AppendLine("					SELECT ECalado, EJE_NS, EL_NS, indicatorname COLLATE Modern_Spanish_CI_AS as indicatorname,")
        s.AppendLine("					CAST(CONVERT(nvarchar, indicatorvalue, 103) + ' ' + CONVERT(nvarchar, indicatorvalue, 108) as nvarchar) as indicatorvalue")
        s.AppendLine("					FROM")
        s.AppendLine("					(")
        s.AppendLine("						SELECT DISTINCT TOP 1 dp.id, dp.Fecha, dp.EJE_NS, dp.EL_NS, CAST(dp.ECalado as nvarchar) as ECalado,")
        s.AppendLine("						dp.Operario, CAST(dp.Valor_B as nvarchar) as Valor_B, CAST(dp.Valor_A as nvarchar) as Valor_A,")
        s.AppendLine("						CAST(dp.Valor_C as nvarchar) as Valor_C, CAST(dp.Valor_D as nvarchar) as Valor_D,")
        s.AppendLine("						CAST(dp.resistance as nvarchar) as resistance,")
        s.AppendLine("						CAST(dp.holgura as nvarchar) as holgura")
        s.AppendLine("						FROM datosPrensa as dp")
        s.AppendLine("						INNER JOIN")
        s.AppendLine("						(")
        s.AppendLine("							SELECT hp.idPieza, hp.Nserie, hp.colada")
        s.AppendLine("							FROM historicoProduc as hp INNER JOIN planosRutasOperaciones as pro on hp.idOperacion = pro.id")
        s.AppendLine("							WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (pro.solicitar_N_Serie = 'True') AND (pro.solicitar_Colada = 'True')")
        s.AppendLine("						) as pieza on (dp.EJE_NS LIKE (pieza.colada + '-' + pieza.Nserie))")
        s.AppendLine("						WHERE (dp.ECalado = @Parte)")
        s.AppendLine("						ORDER BY dp.id DESC")
        s.AppendLine("					) as a")
        s.AppendLine("					UNPIVOT")
        s.AppendLine("					(")
        s.AppendLine("						indicatorvalue")
        s.AppendLine("						FOR indicatorname in (Fecha)")
        s.AppendLine("					) as unpiv")
        s.AppendLine("				) as dp_1 on a.varmaquina = dp_1.indicatorname")
        s.AppendLine("				LEFT OUTER JOIN")
        s.AppendLine("				(")
        s.AppendLine("					/* TEXTO */")
        s.AppendLine("					SELECT ECalado, EJE_NS, EL_NS, indicatorname COLLATE Modern_Spanish_CI_AS as indicatorname, indicatorvalue")
        s.AppendLine("					FROM")
        s.AppendLine("					(")
        s.AppendLine("						SELECT DISTINCT TOP 1 dp.id, dp.Fecha, dp.EJE_NS, dp.EL_NS, CAST(dp.ECalado as nvarchar) as ECalado,")
        s.AppendLine("						dp.Operario, CAST(dp.Valor_B as nvarchar) as Valor_B, CAST(dp.Valor_A as nvarchar) as Valor_A,")
        s.AppendLine("						CAST(dp.Valor_C as nvarchar) as Valor_C, CAST(dp.Valor_D as nvarchar) as Valor_D,")
        s.AppendLine("						CAST(dp.resistance as nvarchar) as resistance,")
        s.AppendLine("						CAST(dp.holgura as nvarchar) as holgura")
        s.AppendLine("						FROM datosPrensa as dp")
        s.AppendLine("						INNER JOIN")
        s.AppendLine("						(")
        s.AppendLine("							SELECT hp.idPieza, hp.Nserie, hp.colada")
        s.AppendLine("							FROM historicoProduc as hp INNER JOIN planosRutasOperaciones as pro on hp.idOperacion = pro.id")
        s.AppendLine("							WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (pro.solicitar_N_Serie = 'True') AND (pro.solicitar_Colada = 'True')")
        s.AppendLine("						) as pieza on (dp.EJE_NS LIKE (pieza.colada + '-' + pieza.Nserie))")
        s.AppendLine("						WHERE (dp.ECalado = @Parte)")
        s.AppendLine("						ORDER BY dp.id DESC")
        s.AppendLine("					) as a")
        s.AppendLine("					UNPIVOT")
        s.AppendLine("					(")
        s.AppendLine("						indicatorvalue")
        s.AppendLine("						FOR indicatorname in (Operario)")
        s.AppendLine("					) as unpiv")
        s.AppendLine("				) as dp_2 on a.varmaquina = dp_2.indicatorname")
        s.AppendLine("				LEFT OUTER JOIN")
        s.AppendLine("				(")
        s.AppendLine("					/* VALORES */")
        s.AppendLine("					SELECT ECalado, EJE_NS, EL_NS, indicatorname COLLATE Modern_Spanish_CI_AS as indicatorname, CAST(indicatorvalue as nvarchar) as indicatorvalue")
        s.AppendLine("					FROM")
        s.AppendLine("					(")
        s.AppendLine("						SELECT DISTINCT TOP 1 dp.id, dp.Fecha, dp.EJE_NS, dp.EL_NS, CAST(dp.ECalado as nvarchar) as ECalado,")
        s.AppendLine("						dp.Operario, CAST(dp.Valor_B as nvarchar) as Valor_B, CAST(dp.Valor_A as nvarchar) as Valor_A,")
        s.AppendLine("						CAST(dp.Valor_C as nvarchar) as Valor_C, CAST(dp.Valor_D as nvarchar) as Valor_D,")
        s.AppendLine("						CAST(dp.resistance as nvarchar) as resistance,")
        s.AppendLine("						CAST(dp.holgura as nvarchar) as holgura")
        s.AppendLine("						FROM datosPrensa as dp")
        s.AppendLine("						INNER JOIN")
        s.AppendLine("						(")
        s.AppendLine("							SELECT hp.idPieza, hp.Nserie, hp.colada")
        s.AppendLine("							FROM historicoProduc as hp INNER JOIN planosRutasOperaciones as pro on hp.idOperacion = pro.id")
        s.AppendLine("							WHERE (hp.idPieza = @idPieza) AND (pro.parte = 0) AND (pro.solicitar_N_Serie = 'True') AND (pro.solicitar_Colada = 'True')")
        s.AppendLine("						) as pieza on (dp.EJE_NS LIKE (pieza.colada + '-' + pieza.Nserie))")
        s.AppendLine("						WHERE (dp.ECalado = @Parte)")
        s.AppendLine("						ORDER BY dp.id DESC")
        s.AppendLine("					) as a")
        s.AppendLine("					UNPIVOT")
        s.AppendLine("					(")
        s.AppendLine("						indicatorvalue")
        s.AppendLine("						FOR indicatorname in (Valor_B, Valor_A, Valor_C, Valor_D, resistance, holgura)")
        s.AppendLine("					) as unpiv")
        s.AppendLine("				) as dp_3 on a.varmaquina = dp_3.indicatorname")
        s.AppendLine("			) as a")
        s.AppendLine("		)")
        s.AppendLine("	WHILE (@Parte <= 8)")
        s.AppendLine("	BEGIN ")
        s.AppendLine("		DECLARE @iIlara int")
        s.AppendLine("		SET @iIlara = 1")
        s.AppendLine("		WHILE (@iIlara < @Zenbat + 1)") 'SI NO PONGO ESTE +1, NO GUARDA EL ULTIMO VALOR DE TODOS
        s.AppendLine("		BEGIN")
        s.AppendLine("			PRINT CAST(@idPieza as nvarchar) + ' Pieza, Parte: ' + CAST(@Parte as nvarchar)")
        s.AppendLine("			SET @Col = (SELECT a.nColumna ")
        s.AppendLine("			FROM ")
        s.AppendLine("			(")
        s.AppendLine("				SELECT DISTINCT a.id, a.idRuta, a.idOperacion, a.idTipoOperacion, a.parte, a.idPuesto, a.idprov, a.orden, a.varmaquina, ")
        s.AppendLine("								a.nColumna, a.colada, a.Nserie, a.idpieza, ")
        s.AppendLine("								ISNULL(dr_1.indicatorname, dr_2.indicatorname) as indicatorname, ")
        s.AppendLine("								ISNULL(dr_1.indicatorvalue, dr_2.indicatorvalue) as indicatorvalue ")
        s.AppendLine("				FROM ")
        s.AppendLine("				(")
        s.AppendLine("					SELECT a.id, a.idRuta, a.idOperacion, a.idTipoOperacion, a.parte, a.idPuesto, a.idprov, a.orden, a.varmaquina, a.nColumna, b.idpieza, b.colada, b.Nserie")
        s.AppendLine("					FROM")
        s.AppendLine("					(")
        s.AppendLine("						SELECT pro.id, pro.idRuta, pro.idOperacion, pro.idTipoOperacion, pro.parte, pro.idPuesto, prov.id as idprov, prov.orden, prov.varmaquina, prov.nColumna ")
        s.AppendLine("						FROM planosRutasOperaciones as pro ")
        s.AppendLine("						LEFT OUTER JOIN planosRutaOperacionesValor as prov on pro.id = prov.idRutaOperacion ")
        s.AppendLine("						WHERE (pro.idTipoOperacion = 6) AND (idPuesto = 99) AND (pro.parte = @Parte)")
        s.AppendLine("					) as a")
        s.AppendLine("					INNER JOIN ")
